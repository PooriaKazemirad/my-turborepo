{
  "name": "shadcn-ui",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@shadcn/react": "catalog:",
    "class-variance-authority": "catalog:",
    "cmdk": "catalog:",
    "cn": "catalog:",
    "date-fns": "catalog:",
    "embla-carousel-react": "catalog:",
    "input-otp": "catalog:",
    "lucide-react": "catalog:",
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-day-picker": "catalog:",
    "react-dom": "catalog:",
    "react-resizable-panels": "catalog:",
    "recharts": "catalog:",
    "shadcn": "catalog:",
    "shiki": "catalog:",
    "tw-animate-css": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "catalog:",
    "jiti": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  },
  "exports": {
    "./tokens.css": "./src/styles/tokens.css",
    "./globals.css": "./src/styles/globals.css",
    "./postcss.config": "./postcss.config.mjs",
    "./lib/highlighter": "./src/lib/highlighter.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./components/atomic/*": "./src/components/atomic/*.tsx",
    "./components/molecules/*": "./src/components/molecules/*.tsx",
    "./components/molecules/charts": "./src/components/molecules/charts/index.ts",
    "./components/molecules/charts/*": "./src/components/molecules/charts/*.tsx",
    "./hooks/*": "./src/hooks/*.ts"
  }
}
